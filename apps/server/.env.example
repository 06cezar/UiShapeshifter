# Copiază în apps/server/.env (nu se comite). Cheia stă doar aici, niciodată în browser sau în git.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# 1 = agent fals, fără OpenRouter (taskul A1)
AGENT_FAKE=1
# Etapa extensiei (1, 2, 3): ce unelte primește modelul. 1 până la M2; 2 după ce extensia are apply_ops, point_at, ask_user, propose_changes.
AGENT_STAGE=1
