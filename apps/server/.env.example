# Copiază în apps/server/.env (nu se comite). Cheia stă doar aici, niciodată în browser sau în git.
OPENROUTER_API_KEY=
# Gol = anthropic/claude-opus-5.5 (implicit din 14 nov.); anthropic/claude-haiku-5.5 e de ~40 de ori mai ieftin.
OPENROUTER_MODEL=
# Când modelul refuză un pas (filtrul de siguranță), rularea continuă pe acesta. Gol = anthropic/claude-sonnet-5.5.
OPENROUTER_FALLBACK_MODEL=
# 1 = agent fals, fără OpenRouter (taskul A1)
AGENT_FAKE=1
# Etapa extensiei (1, 2, 3): ce unelte primește modelul. 2 de la M2 (apply_ops, point_at, propose_changes); 3 adaugă profilul.
AGENT_STAGE=3
# Mod expert (experiment, specs/05 „run_js”): 1 = agentul poate propune cod JavaScript pentru comportamente
# (citește cu voce, scurtături), rulat doar după „Rulează” și doar cu „Mod expert” pornit în extensie.
AGENT_JS=
